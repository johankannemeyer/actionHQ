# Use the pooled connection string from Neon’s Connect dialog.
# Keep this server-only; never prefix it with NEXT_PUBLIC_.
POSTGRES_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Required only when copying the existing local SQLite data into Neon.
SQLITE_PATH=.wrangler/state/v3/d1/miniflare-D1DatabaseObject/your-database.sqlite
